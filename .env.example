# ============================================================
# GoodJob - Environment Variables
# cp .env.example .env 후 실제 값으로 채워주세요
# ============================================================

# ── LLM API ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
TAVILY_API_KEY=tvly-your-key-here

# ── LangSmith (LLMOps / 트레이싱) ────────────────────────────
# https://smith.langchain.com 에서 발급
LANGCHAIN_API_KEY=ls__your-langsmith-key-here
LANGCHAIN_TRACING_V2=true          # true 로 설정해야 추적 활성화
LANGCHAIN_PROJECT=goodjob          # LangSmith 프로젝트 이름
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Ollama (로컬 LLM) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b
# 파인튜닝한 공고 파서 사용 시: LOCAL_MODEL_NAME=goodjob-parser + 아래 true (finetune/colab_finetune.ipynb)
PARSE_WITH_LOCAL_LLM=false

# ── 개인정보 보호 모드 (전체 로컬 처리, Streamlit 사이드바 토글로도 변경 가능) ──
# true 면 OpenAI 호출 차단: 파싱=goodjob-parser, 분석·이력서=qwen2.5:7b, 임베딩=bge-m3
# 필요 모델: ollama pull qwen2.5:7b / ollama pull bge-m3 / goodjob-parser (finetune/ollama/Modelfile)
PRIVACY_MODE=false
PRIVACY_PARSER_MODEL=goodjob-parser
PRIVACY_CHAT_MODEL=qwen2.5:7b
PRIVACY_EMBED_MODEL=bge-m3

# ── Vector Store (Chroma) ────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
# Chroma 서버 주소 (비우면 위 폴더를 직접 사용 — 단일 프로세스 전용).
# Streamlit 과 API 를 동시에 띄우려면 서버 사용: chroma run --path ./chroma_db --port 8001
# docker compose 는 자동으로 설정하므로 여기서는 비워 둠
CHROMA_HOST=
CHROMA_PORT=8000

# ── 임베딩 ───────────────────────────────────────────────────
# true: OpenAI text-embedding-3-small / false: 로컬 BGE-M3
# (변경 시 벡터 차원이 달라지므로 chroma_db 삭제 후 프로필 재업로드 필요)
USE_OPENAI_EMBEDDINGS=true

# ── RAG 품질 (Reranker) ──────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RAGAS 평가 결과 한국어 IT 프로필에서 recall 저하 → 기본 비활성 (PROJECT_DOCS #010)
RERANKER_ENABLED=false
RAG_TOP_K_INITIAL=20               # 벡터 검색 후보 수
RAG_TOP_K_FINAL=5                  # 리랭킹 후 최종 반환 수

# ── LLM 라우팅 ───────────────────────────────────────────────
LLM_ROUTER_THRESHOLD=0.6

# ── Redis (세션 캐시) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false                # true 로 바꾸면 Redis 사용

# ── MLflow (파인튜닝 실험 관리) ───────────────────────────────
MLFLOW_TRACKING_URI=./mlflow_runs
MLFLOW_EXPERIMENT_NAME=goodjob-finetune

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit ────────────────────────────────────────────────
STREAMLIT_PORT=8501
BACKEND_URL=http://localhost:8000
