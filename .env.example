# ============================================================
# GoodJob - Environment Variables
# cp .env.example .env 후 실제 값으로 채워주세요
# ============================================================

# ── LLM API ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
TAVILY_API_KEY=tvly-your-key-here

# ── LangSmith (LLMOps / 트레이싱) ────────────────────────────
# https://smith.langchain.com 에서 발급
LANGCHAIN_API_KEY=ls__your-langsmith-key-here
LANGCHAIN_TRACING_V2=true          # true 로 설정해야 추적 활성화
LANGCHAIN_PROJECT=goodjob          # LangSmith 프로젝트 이름
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Ollama (로컬 LLM) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b

# ── Vector Store (Chroma) ────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── RAG 품질 (Reranker) ──────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RAG_TOP_K_INITIAL=20               # 벡터 검색 후보 수
RAG_TOP_K_FINAL=5                  # 리랭킹 후 최종 반환 수

# ── LLM 라우팅 ───────────────────────────────────────────────
LLM_ROUTER_THRESHOLD=0.6

# ── Redis (세션 캐시) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false                # true 로 바꾸면 Redis 사용

# ── MLflow (파인튜닝 실험 관리) ───────────────────────────────
MLFLOW_TRACKING_URI=./mlflow_runs
MLFLOW_EXPERIMENT_NAME=goodjob-finetune

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Streamlit ────────────────────────────────────────────────
STREAMLIT_PORT=8501
BACKEND_URL=http://localhost:8000
