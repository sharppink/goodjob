{
  "name": "GoodJob - Resume Generation Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "goodjob/resume",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000001",
      "name": "Webhook: Resume request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "goodjob-resume"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GOODJOB_API_URL }}/resume/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ company_name: $json.body.company_name, job_posting_text: $json.body.job_posting_text, job_url: $json.body.job_url, generate_interview: $json.body.generate_interview ?? true }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000002",
      "name": "GoodJob: POST /resume/generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1b2c3d4-0003-4000-8000-0000000000c1",
              "leftValue": "={{ $json.resume_final.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000003",
      "name": "Resume generated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `:white_check_mark: ${$json.company_name} 이력서 생성 완료 — 적합도 ${Math.round($json.fit_score * 100)}%\n보유: ${$json.matched_skills.join(', ')}\n부족: ${$json.missing_skills.join(', ') || '없음'}\n면접 예상 질문 ${$json.interview_questions.length}개\n세션: ${$json.session_id}` }) }}",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000004",
      "name": "Slack: success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `:warning: ${$json.company_name} 적합도 ${Math.round($json.fit_score * 100)}% — 기준 미달로 이력서를 생성하지 않았습니다.\n부족: ${$json.missing_skills.join(', ')}` }) }}",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000005",
      "name": "Slack: low fit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('GoodJob: POST /resume/generate').item.json) }}",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000006",
      "name": "Respond with result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Webhook: Resume request": { "main": [[{ "node": "GoodJob: POST /resume/generate", "type": "main", "index": 0 }]] },
    "GoodJob: POST /resume/generate": { "main": [[{ "node": "Resume generated?", "type": "main", "index": 0 }]] },
    "Resume generated?": {
      "main": [
        [{ "node": "Slack: success", "type": "main", "index": 0 }],
        [{ "node": "Slack: low fit", "type": "main", "index": 0 }]
      ]
    },
    "Slack: success": { "main": [[{ "node": "Respond with result", "type": "main", "index": 0 }]] },
    "Slack: low fit": { "main": [[{ "node": "Respond with result", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
